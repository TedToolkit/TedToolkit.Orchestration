<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishTrimmed>true</PublishTrimmed>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../src/TedToolkit.Orchestration.Pipeline/TedToolkit.Orchestration.Pipeline.csproj" />
    <ProjectReference Include="../../src/TedToolkit.Orchestration.Pipeline.Analyzer/TedToolkit.Orchestration.Pipeline.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../src/TedToolkit.Orchestration.Pipeline.Analyzer/AnalyzerDependencies.props" />
</Project>

