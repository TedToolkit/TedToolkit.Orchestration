<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="TedToolkit SDK" value="https://raw.githubusercontent.com/TedToolkit/TedToolkit/refs/tags/build-sdk-v0.1.0-preview.1/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="TedToolkit SDK">
      <package pattern="TedToolkit.Build.Sdk" />
    </packageSource>
  </packageSourceMapping>
</configuration>
