<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../externals/TedToolkit/props/NugetPackage.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <Description>Compile-time state machine orchestration library.</Description>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TedToolkit.Orchestration.StateMachine.Analyzer/TedToolkit.Orchestration.StateMachine.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="README.md" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../TedToolkit.Orchestration.StateMachine.Analyzer/bin/$(Configuration)/netstandard2.0/TedToolkit.Orchestration.StateMachine.Analyzer.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
</Project>
