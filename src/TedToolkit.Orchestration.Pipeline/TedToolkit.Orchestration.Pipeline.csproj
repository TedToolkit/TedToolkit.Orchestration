<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../externals/TedToolkit/props/NugetPackage.props" />
  <Import Project="../../externals/TedToolkit/props/AlmostAllFrameworks.props" />
  <PropertyGroup>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">true</IsTrimmable>
    <Description>Pipeline orchestration library.</Description>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../TedToolkit.Orchestration.Pipeline.Analyzer/TedToolkit.Orchestration.Pipeline.Analyzer.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishTrimmed;TrimMode;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <Import Project="../TedToolkit.Orchestration.Pipeline.Analyzer/AnalyzerAssets.props" />
  <ItemGroup>
    <None Remove="README.md" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="@(_TedPipelineAnalyzerAsset)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>
</Project>

