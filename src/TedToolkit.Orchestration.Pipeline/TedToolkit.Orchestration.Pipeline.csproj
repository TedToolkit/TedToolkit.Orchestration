<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../externals/TedToolkit/props/NugetPackage.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <Description>Pipeline orchestration library.</Description>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../TedToolkit.Orchestration.Pipeline.Analyzer/TedToolkit.Orchestration.Pipeline.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishTrimmed;TrimMode;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="README.md" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../TedToolkit.Orchestration.Pipeline.Analyzer/bin/$(Configuration)/netstandard2.0/TedToolkit.Orchestration.Pipeline.Analyzer.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
  <Import Project="../TedToolkit.Orchestration.Pipeline.Analyzer/AnalyzerDependencies.props" />
  <ItemGroup>
    <None Include="@(_TedPipelineAnalyzerDependency)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>
</Project>

